# --- Firebase Admin (API Routes: pagos QR, WhatsApp send) ---
# Service account: Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=udreamms-platform-1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Solana / Crypto checkout (público en cliente + servidor) ---
NEXT_PUBLIC_TREASURY_WALLET=E5eZJPT2un3X2RZZK4yXvkiGKbkkRtGH1GwWsUBSxLD3
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# LXR no está en Jupiter — precio USD manual
NEXT_PUBLIC_LXR_USD_PRICE=

# --- WhatsApp Cloud API (solo /api/whatsapp/send en Vercel) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Google Analytics 4 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-20S9HSQFEW

