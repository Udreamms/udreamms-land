# =============================================================================
# Next.js — Local (.env.local) y Vercel (Environment Variables)
# Copiar a .env.local o importar en Vercel Dashboard
# =============================================================================

# --- Firebase Admin (API Routes: pagos QR, WhatsApp send) ---
# Service account: Firebase Console → Project settings → Service accounts
FIREBASE_PROJECT_ID=udreamms-platform-1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Solana / Crypto checkout (público en cliente + servidor) ---
NEXT_PUBLIC_TREASURY_WALLET=E5eZJPT2un3X2RZZK4yXvkiGKbkkRtGH1GwWsUBSxLD3
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Token Luxor (LXR) — contrato Solana mainnet
NEXT_PUBLIC_LXR_MINT=7Qm6qUCXGZfGBYYFzq2kTbwTDah5r3d9DcPJHRT8Wdth
# Etiqueta UI hasta que Jupiter publique precio (lanzamiento público)
NEXT_PUBLIC_LXR_LAUNCH_LABEL=enero 2027
# Solo para pruebas pre-lanzamiento; en producción Jupiter alimenta el precio solo
NEXT_PUBLIC_LXR_USD_PRICE=
# Forzar pestaña LXR antes de que Jupiter cotice (testing). En enero 2027 no hace falta.
NEXT_PUBLIC_LXR_PAYMENTS_ENABLED=
# Opcional: clave Jupiter para producción (https://portal.jup.ag)
JUPITER_API_KEY=

# --- WhatsApp Cloud API (solo /api/whatsapp/send en Vercel) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Firebase Client (web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Stripe (servidor) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe (público — URLs de retorno tras pago) ---
NEXT_PUBLIC_PORTAL_STRIPE_SUCCESS_URL=https://www.udreamms.com/portal?stripe=success
NEXT_PUBLIC_BOOK_STRIPE_SUCCESS_URL=https://www.udreamms.com/visas/student/book?stripe=success

# Payment links configurados en código (src/lib/payments/stripe-links.ts)
# Webhook: POST https://www.udreamms.com/api/payments/stripe/webhook
# Evento: checkout.session.completed
# En cada Payment Link de Stripe → After payment → Success URL:
#   Portal planes: https://www.udreamms.com/portal?stripe=success
#   Libro digital: https://www.udreamms.com/visas/student/book?stripe=success
# Metadata recomendada en cada link (clave product_id):
#   plan-esencial, plan-pro, plan-elite, plan-allinclusive,
#   plan-turista-basico, plan-turista-premium, plan-turista-vip, libro-estudiante
