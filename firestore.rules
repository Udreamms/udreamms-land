rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to manage Kanban groups
    match /kanban-groups/{groupId} {
      allow read, create, update, delete: if request.auth != null;

      // Allow authenticated users to manage cards within a group
      match /cards/{cardId} {
        allow read, create, update, delete: if request.auth != null;
      }
    }

    // This rule allows the search functionality to work.
    // It lets any authenticated user read from the 'cards' collection group.
    match /{path=**}/cards/{cardId} {
      allow read: if request.auth != null;
    }

    // Allows any authenticated user to create, read, update, and delete chatbots.
    match /chatbots/{botId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // New rule for contacts collection
    match /contacts/{contactId} {
      allow read, write: if request.auth != null;
    }

    // Client portal: each signed-in user may read and maintain only their own profile doc.
    // The portal listens to it (PortalContext) to know which plans are unlocked, and the
    // login page creates/updates it. `role` can never be changed from the browser.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'client';
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;
    }

    // Portal chat: a signed-in client may read (never write) only their own thread.
    // Writes go through /api/portal/chat (Admin SDK).
    match /portal_chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && resource.data.clientEmail.lower() == request.auth.token.email.lower();
      allow write: if false;
    }

    // Visa crypto QR payments — written only by Firebase Admin (API routes).
    // Clients must not read/write payment sessions or comprobantes directly.
    match /visaCryptoSessions/{sessionId} {
      allow read, write: if false;

      match /paymentRequests/{requestId} {
        allow read, write: if false;
      }
    }

    match /visaCryptoComprobantes/{comprobanteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
